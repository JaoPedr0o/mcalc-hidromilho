  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "tsx --test tests/*.test.ts",
    "test:cov": "tsx --test --experimental-test-coverage tests/*.test.ts",
